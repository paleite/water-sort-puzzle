{
  "name": "water-sort",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "build": "next build",
    "dev": "next dev --turbopack",
    "format": "prettier --write --ignore-unknown .",
    "lint": "eslint --cache src scripts",
    "spellcheck": "cspell --config=cspell.json README.md VALIDATION.md package.json src scripts --no-progress --show-context --show-suggestions",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "generate:levels": "tsx scripts/water-sort/generate-levels.ts",
    "verify:levels": "tsx scripts/water-sort/verify-levels.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@gsap/react": "^2.1.2",
    "@xstate/react": "^6.1.0",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lucide-react": "^1.20.0",
    "next": "16.3.4",
    "pixi.js": "8.20.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "xstate": "^5.32.6",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@next/eslint-plugin-next": "16.3.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@tsconfig/next": "^2.0.6",
    "@tsconfig/strictest": "^2.0.8",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "cspell": "8.17.5",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.3.4",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  }
}
